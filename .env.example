# ============================================
# SIEM Platform - Environment Configuration
# ============================================
# Copy this file to .env and adjust values for your environment


# ----- General -----
COMPOSE_PROJECT_NAME=siem-platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----- PostgreSQL -----
POSTGRES_USER=siem_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=siem
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Ingestor service -----
INGESTOR_HOST=0.0.0.0
INGESTOR_PORT=8001

# ----- Normalizer service -----
NORMALIZER_HOST=0.0.0.0
NORMALIZER_PORT=8002

# ----- Correlator service -----
CORRELATOR_HOST=0.0.0.0
CORRELATOR_PORT=8003

# ----- Alert Manager service -----
ALERT_MANAGER_HOST=0.0.0.0
ALERT_MANAGER_PORT=8004
ALERT_WEBHOOK_URL=

# ----- API Gateway -----
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8005

# ----- Demo webapp (log source) -----
DEMO_WEBAPP_PORT=9000
DEMO_WEBAPP_SECRET_KEY=demo_secret_change_me

# ----- Nginx -----
NGINX_HTTP_PORT=8080

# ----- Frontend -----
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000